{
  "name": "numiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestión completa para autónomos y pequeñas empresas: facturación, gastos, impuestos, VeriFactu e IA.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/db-local.mjs --ensure && nuxt dev --host 0.0.0.0 --port 3210",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:imports": "node --experimental-strip-types --test scripts/import-duplicates.test.mjs",
    "test:file-dates": "node --experimental-strip-types --test scripts/file-dates.test.mjs",
    "test:import-reading": "node --experimental-strip-types --test scripts/import-reading.test.mjs",
    "test:file-preview": "node --experimental-strip-types --test scripts/file-preview.test.mjs",
    "test:imports:integration": "npm run build && node scripts/import-duplicates.integration.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local": "node scripts/db-local.mjs",
    "db:stop": "node scripts/db-local.mjs --stop",
    "clone:export": "npx tsx scripts/clone-export.mjs",
    "clone:import": "npx tsx scripts/clone-import.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/icon": "^2.5.1",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "docx-preview": "^0.4.1",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "mysql2": "^3.24.6",
    "node-forge": "^1.4.0",
    "nodemailer": "^7.0.13",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pdfmake": "^0.3.12",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
