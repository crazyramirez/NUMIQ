# ═══ NUMIQ · variables de entorno ═════════════════════════════════════════════
# Plantilla: cópiala como .env (no se sube a git).

# ─── Base de datos MariaDB / MySQL ────────────────────────────────────────────
# Local: `npm run dev` arranca solo un MariaDB portable del proyecto en 127.0.0.1:3308 (Windows).
NUXT_DATABASE_URL=mysql://root:@127.0.0.1:3308/numiq
# Producción (Plesk): variables sueltas, la contraseña no necesita codificarse. Tienen prioridad.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_NAME=numiq

# ─── Sesiones (OBLIGATORIO: 32+ caracteres aleatorios) ─────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# ─── Custodia cifrada: certificados digitales y claves de OpenAI de los usuarios ─
# Clave para cifrarlos en la base de datos (32+ caracteres). Si falta, se usa la de sesión:
# entonces, cambiar NUXT_SESSION_PASSWORD obliga a volver a subir el certificado y a pegar las claves.
# NUXT_CERT_SECRET=
# Productor del sistema informático en los registros VeriFactu (por defecto, la propia empresa)
# NUXT_VERIFACTU_PRODUCER_NAME=
# NUXT_VERIFACTU_PRODUCER_NIF=

# ─── Archivos subidos (facturas escaneadas, logos…) ───────────────────────────
NUXT_UPLOADS_DIR=./storage/uploads

# ─── IA (OpenAI): lectura de facturas, tickets y fotos, importación y asistente ─
# Ya no hay clave aquí: cada usuario pega la suya en Ajustes → Inteligencia artificial y se guarda
# cifrada (NUXT_CERT_SECRET). Quien no tiene clave usa la del titular de su empresa.
# Modelos (opcional): lectura rápida y segunda lectura cuando algo no cuadra
# NUXT_OPENAI_MODEL=gpt-5.4-mini
# NUXT_OPENAI_PRO_MODEL=gpt-5.5
# NUXT_OPENAI_CONCURRENCY=4
# Tarifas propias en USD por millón de tokens (entrada, caché, salida) si OpenAI cambia un precio:
# NUXT_OPENAI_PRICES={"gpt-5.5":[5,0.5,30]}

# ─── Correo (Gmail): enviar facturas y recordatorios, recibir facturas por email ─
# Activa la verificación en 2 pasos y crea una contraseña de aplicación en
# https://myaccount.google.com/apppasswords (los espacios se ignoran).
# La misma cuenta recibe por IMAP las facturas que te reenvíen (importación con IA).
GOOGLE_APP_EMAIL=
GOOGLE_APP_PASSWORD=
# URL pública para los enlaces de los correos. Local: http://localhost:3210
NUXT_SITE_URL=
# Otro proveedor en vez de Gmail (opcional)
# NUXT_MAIL_SMTP_HOST=smtp.tudominio.es
# NUXT_MAIL_SMTP_PORT=465
# NUXT_MAIL_IMAP_HOST=imap.tudominio.es
# NUXT_MAIL_USER=facturas@tudominio.es
# NUXT_MAIL_PASSWORD=
# NUXT_MAIL_FROM=Mi Empresa <facturas@tudominio.es>
# Cada empresa recibe facturas en su alias (cuenta+empresa@gmail.com). Para buscar en TODO el buzón:
# el usuario de NUMIQ con el mismo email que la cuenta, o los indicados aquí (separados por comas)
# NUXT_MAIL_INBOX_OWNERS=tu@email.com
# Modo pruebas: solo salen correos a estas direcciones o @dominios (el resto se omite). Vacío = sin límite
# NUXT_MAIL_ONLY_TO=tu@email.com